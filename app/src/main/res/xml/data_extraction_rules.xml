<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+ 雲端備份：要求裝置具備端對端加密能力，且僅備份使用者資料庫與設定 -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <include domain="file" path="datastore/stock_assistant_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <include domain="file" path="datastore/stock_assistant_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
